package siga;

import java.time.LocalDate;

public class AtestadoFrequencia extends DocumentoAcademico {
    @Override
    protected String corpo(Aluno aluno) {
        return "ATESTADO DE FREQUENCIA\n" + aluno.getNome() + "\n---\nEmitido em " + LocalDate.now();
    }
    @Override
    protected boolean exigeAssinatura() { return false; }
    @Override
    protected void registrarEmissao(Aluno aluno) { LogAcademico.registrar("ATESTADO", aluno); }
}